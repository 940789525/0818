{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Score MSRVTT (train) - best.pth",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/score_msr_vtt.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--ckpt", "${workspaceFolder}/log/MSRVTT_train_b64_2_0923_lora_1/best.pth",
        "--anno_path", "/home/wa24301158/dataset/MSRVTT",                // 主目录；脚本会自动拼接 anns
        "--video_path", "/home/wa24301158/dataset/MSRVTT/all_compressed",
        "--subset", "train",
        "--out_dir", "${workspaceFolder}/log/sft_mined_from_best_neg50",
        "--output_dir", "${workspaceFolder}/log/sft_mined_from_best_neg50",     // 传给 main.get_args 的必需项
        "--lambda_neg", "0.5",
        "--topk", "3",
        "--bottomk", "3",
        "--pretrained_path", "tvr/models",
        "--batch_size", "64",
        "--workers", "8",
        "--device", "cuda",
        "--limit_sentences", "180000"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "2"
      },
      "python": "/home/wa24301158/conda_envs/temp/bin/python"
    },
    {
      "name": "Debug TempMe on MSRVTT (Single GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--do_train", "1",
        "--workers", "8",
        "--batch_size", "16",
        "--n_display", "5",
        "--batch_size_val", "16",
        "--anno_path", "/home/wa24301158/dataset/MSRVTT",
        "--epochs", "1",
        "--video_path", "/home/wa24301158/dataset/MSRVTT/all_compressed",
        "--datatype", "msrvtt",
        "--output_dir", "log/MSRVTT_custom_debug_0917",
        "--pretrained_path", "/home/wa24301158/mywork/TempMe-master/tvr/models",
      ],
      "env": {
        // 强制使用单卡
        "CUDA_VISIBLE_DEVICES": "3",
        // --- 新增的环境变量，用于修复 RANK 错误 ---
        "MASTER_ADDR": "localhost",
        "MASTER_PORT": "29500", // 任意未被占用的端口
        "RANK": "0",
        "WORLD_SIZE": "1"
      },
      // 重要：请将下面的路径修改为您项目所用的 Conda 环境中的 Python 解释器路径
      "python": "/home/wa24301158/conda_envs/temp/bin/python"
    }
  ]
}
